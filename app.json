{
  "expo": {
    "name": "trapy",
    "slug": "trapy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "16.4",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow trapy to transcribe your voice into journal entries.",
        "NSMicrophoneUsageDescription": "Allow trapy to use your microphone for voice journaling."
      },
      "bundleIdentifier": "com.anonymous.trapy"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow trapy to use your microphone for voice journaling.",
          "speechRecognitionPermission": "Allow trapy to transcribe your voice into journal entries."
        }
      ]
    ]
  }
}
